# SecureChat 服务端环境变量示例
# 复制本文件为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会进入版本库）
# Docker 部署时：docker compose --env-file server/.env up -d

# ── 服务监听 ──
# HTTP / WebSocket / 管理后台均走此端口
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# ── 安全 ──
# 首次启动的初始管理员密码（仅在库内无管理员时生效，首次登录强制改密）
ADMIN_INITIAL_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD

# JWT 签名密钥 —— 生产环境务必设置为足够长的随机字符串
# 生成示例： openssl rand -base64 48
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_JWT_SECRET

# ── 对外访问 ──
# 对外暴露的基址（用于 OTA 下载链接拼接、管理后台「域名绑定」展示）
# 例：https://your-domain.example.com  （经反向代理 / DDNS 对外暴露的地址）
SERVER_DOMAIN=https://your-domain.example.com

# ── 消息保留 ──
# 服务端留存消息的天数（1-365，默认 7）
RETENTION_DAYS=7
